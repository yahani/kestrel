# Copy to .env (next to your config file, or in the folder you run tracker from) and fill in.
# Never commit .env. On GitHub Actions, set these as repository secrets instead.

# Email digest (SMTP). Only needed when alerts.email.enabled is true.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<the Gmail address>,
#        SMTP_PASSWORD=<a 16-character app password, not your normal password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional: defaults to SMTP_USER. Can include a name: Price Tracker <you@example.com>
SMTP_FROM=
# Optional: starttls (default), ssl (default when SMTP_PORT=465) or none (local test relay only)
SMTP_SECURITY=

# Slack digest (incoming webhook URL). Only needed when alerts.slack.enabled is true.
SLACK_WEBHOOK_URL=

# Google Sheets export: path to the service-account key file (JSON). Only needed when
# sheets.enabled is true. Keep the key file outside the repo.
GOOGLE_SERVICE_ACCOUNT_JSON=
